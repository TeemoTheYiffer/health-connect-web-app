# Local dev defaults, copy to .env and fill in.

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
# 32+ random bytes; used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database ---
# SQLite for local dev (no install needed). Switch to postgresql+psycopg://... for prod.
DATABASE_URL=sqlite:///./hcw.db

# --- Google OAuth (web sign-in for visitors) ---
# Web OAuth client from Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URI: http://localhost:8000/auth/callback (dev), https://<your-domain>/auth/callback (prod).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Comma-separated emails allowed to view the site. The owner is implicitly allowed.
ALLOWED_EMAILS=joeaguirre0@yahoo.com

# Owner email, has admin privileges (e.g. /admin/sync trigger).
OWNER_EMAIL=joeaguirre0@yahoo.com

# --- Google Drive (sync source) ---
# Folder ID in Drive containing Health Connect export zips (the part after /folders/ in the URL).
DRIVE_FOLDER_ID=
# Path to the OAuth user-credentials JSON for Drive read access.
# Run scripts/bootstrap_drive_oauth.py once to create this.
DRIVE_CREDENTIALS_JSON_PATH=.secrets/drive_credentials.json
DRIVE_TOKEN_JSON_PATH=.secrets/drive_token.json

# --- Local dev shortcut ---
# Path to a local Health Connect SQLite file. If set, `hcw-sync --local` reads from this
# instead of going to Drive, useful for offline iteration.
LOCAL_HEALTH_CONNECT_DB=./health_connect_export.db
